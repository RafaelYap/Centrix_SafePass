{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "full-apk": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleFullRelease"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "full",
        "EXPO_PUBLIC_API_MODE": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://safepass-052h.onrender.com/api",
        "EXPO_PUBLIC_ENABLE_DEV_FALLBACK": "false",
        "EXPO_PUBLIC_E2E_LOCAL_ONLY": "false"
      }
    },
    "visitor-apk": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleVisitorRelease"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "visitor",
        "EXPO_PUBLIC_API_MODE": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://safepass-052h.onrender.com/api",
        "EXPO_PUBLIC_ENABLE_DEV_FALLBACK": "false",
        "EXPO_PUBLIC_E2E_LOCAL_ONLY": "false"
      }
    },
    "full-ios": {
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "full",
        "EXPO_PUBLIC_API_MODE": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://safepass-052h.onrender.com/api",
        "EXPO_PUBLIC_ENABLE_DEV_FALLBACK": "false",
        "EXPO_PUBLIC_E2E_LOCAL_ONLY": "false"
      }
    },
    "full-ios-preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "full",
        "EXPO_PUBLIC_API_MODE": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://safepass-052h.onrender.com/api",
        "EXPO_PUBLIC_ENABLE_DEV_FALLBACK": "false",
        "EXPO_PUBLIC_E2E_LOCAL_ONLY": "false"
      }
    },
    "full-ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "full",
        "EXPO_PUBLIC_API_MODE": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://safepass-052h.onrender.com/api",
        "EXPO_PUBLIC_ENABLE_DEV_FALLBACK": "false",
        "EXPO_PUBLIC_E2E_LOCAL_ONLY": "false"
      }
    },
    "visitor-ios": {
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "visitor",
        "EXPO_PUBLIC_API_MODE": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://safepass-052h.onrender.com/api",
        "EXPO_PUBLIC_ENABLE_DEV_FALLBACK": "false",
        "EXPO_PUBLIC_E2E_LOCAL_ONLY": "false"
      }
    },
    "visitor-debug-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleVisitorDebug"
      },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "visitor"
      }
    },
    "full-android-store": {
      "extends": "full-apk",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleFullRelease"
      }
    }
  },
  "submit": {
    "full-ios": {
      "ios": {
        "ascAppId": "6835368063",
        "appleTeamId": "94NL23B23D"
      }
    }
  }
}
